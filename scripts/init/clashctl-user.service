[Unit]
Description=Per-user clashctl mihomo service
After=network.target

[Service]
Type=simple
UMask=0077
RuntimeDirectory=clashctl
NoNewPrivileges=true
PrivateTmp=true
ExecStart=@CLASHCTL_ROOT@/scripts/run-mihomo
ExecStopPost=/usr/bin/rm -f %t/clashctl/mihomo.pid
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
