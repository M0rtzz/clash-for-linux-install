#!/usr/bin/env bash

set -o errexit -o pipefail
CLASHCTL_INSTALL_MODE=system
if [ -n "${CLASHCTL_TEST_ROOT:-}" ]; then
    CLASHCTL_ROOT=${CLASHCTL_TEST_ROOT}
else
    CLASHCTL_RUN_PATH=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || true)
    case "${CLASHCTL_RUN_PATH}" in
    */scripts/run-mihomo) CLASHCTL_ROOT=${CLASHCTL_RUN_PATH%/scripts/run-mihomo} ;;
    *) CLASHCTL_ROOT=/usr/local/lib/clashctl ;;
    esac
fi
export CLASHCTL_INSTALL_MODE CLASHCTL_ROOT
. "${CLASHCTL_ROOT}/.env" || exit 1
for library in "${CLASHCTL_ROOT}"/scripts/lib/*.sh; do
    # shellcheck disable=SC1090
    . "${library}"
done
_ensure_user_home || exit 1

temporary_pid_file="${CLASH_PID_FILE}.${$}"
if ! printf '%s\n' "${$}" >"${temporary_pid_file}" ||
    ! chmod 600 "${temporary_pid_file}" ||
    ! /bin/mv -f "${temporary_pid_file}" "${CLASH_PID_FILE}"; then
    /usr/bin/rm -f -- "${temporary_pid_file}"
    exit 1
fi
exec "${BIN_KERNEL}" -d "${CLASH_RESOURCES_DIR}" -f "${CLASH_CONFIG_RUNTIME}"
